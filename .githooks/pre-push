#!/usr/bin/env bash
# Git hook: pre-push
# Validates branch naming convention before pushing to remote.

set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${local_ref#refs/heads/}"

  # Skip main/master/develop/dev/demo — long-lived branches
  if [[ "$branch" == "main" || "$branch" == "master" || "$branch" == "develop" || "$branch" == "dev" || "$branch" == "demo" ]]; then
    continue
  fi

  # Skip tags
  if [[ "$local_ref" == refs/tags/* ]]; then
    continue
  fi

  pattern='^(feature|fix|hotfix|chore|docs|test|perf|refactor)/[A-Z]+-[0-9]+-[a-z0-9-]+$'

  if [[ ! "$branch" =~ $pattern ]]; then
    echo ""
    echo "  ❌ Invalid branch name: $branch"
    echo ""
    echo "  Expected: <type>/<TICKET-ID>-<short-description>"
    echo ""
    echo "  Types: feature, fix, hotfix, chore, docs, test, perf, refactor"
    echo ""
    echo "  Example: feature/JUS-123-add-alert-rules"
    echo ""
    exit 1
  fi

  echo "  ✅ Branch '$branch' follows naming convention."
done

exit 0
