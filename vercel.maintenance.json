{
  "buildCommand": "echo 'Static site - no build required'",
  "outputDirectory": ".",
  "framework": null,
  "devCommand": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/maintenance.html" }
  ],
  "headers": [
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
